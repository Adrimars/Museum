// MuseumQuest — Prisma Schema
// PRD §12 — all 17 tables

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), pgcrypto, pg_trgm, vector, timescaledb]
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  user
  content_editor
  museum_admin
  super_admin
}

enum Difficulty {
  easy
  medium
  hard
}

enum ContentStatus {
  draft
  published
}

enum GameState {
  IDLE
  CLUE_ACTIVE
  QR_SCANNED
  ANSWER_SUBMITTED
  CORRECT
  INCORRECT
  FINAL_CODE
  COMPLETED
  EXPIRED
}

enum RewardType {
  badge
  certificate
  discount_code
}

enum RewardTriggerType {
  game_completion
  quiz_threshold
}

enum AiMessageRole {
  user
  assistant
}

enum AiFlagStatus {
  unflagged
  flagged
  dismissed
}

// ─────────────────────────────────────────────
// TABLE 1: users
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique @db.VarChar(255)
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  displayName   String    @map("display_name") @db.VarChar(50)
  avatarUrl     String?   @map("avatar_url") @db.VarChar(500)
  role          UserRole  @default(user)
  museumId      String?   @map("museum_id") @db.Uuid
  totalPoints   Int       @default(0) @map("total_points")
  preferences   Json      @default("{}") @db.JsonB
  dateOfBirth   DateTime  @map("date_of_birth") @db.Date
  isBanned      Boolean   @default(false) @map("is_banned")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  museum          Museum?          @relation(fields: [museumId], references: [id])
  refreshTokens   RefreshToken[]
  gameSessions    GameSession[]
  quizSessions    QuizSession[]
  quizScores      MuseumQuizScore[]
  aiChatSessions  AiChatSession[]
  userRewards     UserReward[]
  auditLogs       AuditLog[]       @relation("ActorAuditLogs")

  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────────
// TABLE 2: refresh_tokens
// ─────────────────────────────────────────────

model RefreshToken {
  jti         String   @id @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash") @db.VarChar(64)
  deviceHint  String?  @map("device_hint") @db.VarChar(255)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  isRevoked   Boolean  @default(false) @map("is_revoked")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// TABLE 3: museums
// ─────────────────────────────────────────────

model Museum {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(200)
  description String?  @db.Text
  logoUrl     String?  @map("logo_url") @db.VarChar(500)
  address     Json     @db.JsonB
  settings    Json     @default("{}") @db.JsonB
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  users           User[]
  artifacts       Artifact[]
  qrCodes         QrCode[]
  gameScenarios   GameScenario[]
  gameSessions    GameSession[]
  quizQuestions   QuizQuestion[]
  quizSessions    QuizSession[]
  quizScores      MuseumQuizScore[]
  aiChatSessions  AiChatSession[]
  rewards         Reward[]
  analyticsEvents AnalyticsEvent[]
  auditLogs       AuditLog[]

  @@map("museums")
}

// ─────────────────────────────────────────────
// TABLE 4: artifacts
// ─────────────────────────────────────────────

model Artifact {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  museumId          String   @map("museum_id") @db.Uuid
  name              String   @db.VarChar(300)
  description       String?  @db.Text
  historicalContext String?  @map("historical_context") @db.Text
  period            String?  @db.VarChar(100)
  mediaUrls         Json     @default("[]") @map("media_urls") @db.JsonB
  audioGuideUrl     String?  @map("audio_guide_url") @db.VarChar(500)
  audioTranscript   String?  @map("audio_transcript") @db.Text
  locationHint      String?  @map("location_hint") @db.VarChar(300)
  // vector(1536) — pgvector column added via raw SQL migration (S4-01/S4-04).
  // Prisma does not have a native vector type; raw SQL is used for reads/writes.
  embedding         Unsupported("vector(1536)")?
  metadata          Json     @default("{}") @db.JsonB
  suggestedQuestions Json    @default("[]") @map("suggested_questions") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  museum        Museum         @relation(fields: [museumId], references: [id])
  qrCode        QrCode?
  quizQuestions QuizQuestion[]
  aiSessions    AiChatSession[]

  @@index([museumId])
  @@map("artifacts")
}

// ─────────────────────────────────────────────
// TABLE 5: qr_codes
// ─────────────────────────────────────────────

model QrCode {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  museumId   String   @map("museum_id") @db.Uuid
  artifactId String   @unique @map("artifact_id") @db.Uuid
  codeHash   String   @unique @map("code_hash") @db.VarChar(128)
  kid        String   @db.VarChar(50)
  imageUrl   String   @map("image_url") @db.VarChar(500)
  scanCount  Int      @default(0) @map("scan_count")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  museum   Museum   @relation(fields: [museumId], references: [id])
  artifact Artifact @relation(fields: [artifactId], references: [id])

  @@index([codeHash])
  @@map("qr_codes")
}

// ─────────────────────────────────────────────
// TABLE 6: game_scenarios
// ─────────────────────────────────────────────

model GameScenario {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  museumId   String        @map("museum_id") @db.Uuid
  title      String        @db.VarChar(300)
  storyIntro String        @map("story_intro") @db.Text
  difficulty Difficulty
  status     ContentStatus @default(draft)
  clues      Json          @default("[]") @db.JsonB
  finalCode  String        @map("final_code") @db.VarChar(50)
  rewardId   String?       @map("reward_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime?     @map("deleted_at") @db.Timestamptz

  museum       Museum        @relation(fields: [museumId], references: [id])
  reward       Reward?       @relation(fields: [rewardId], references: [id])
  gameSessions GameSession[]

  @@index([museumId])
  @@map("game_scenarios")
}

// ─────────────────────────────────────────────
// TABLE 7: game_sessions
// ─────────────────────────────────────────────

model GameSession {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String?   @map("user_id") @db.Uuid
  guestTokenJti         String?   @map("guest_token_jti") @db.VarChar(128)
  scenarioId            String    @map("scenario_id") @db.Uuid
  museumId              String    @map("museum_id") @db.Uuid
  state                 GameState @default(IDLE)
  currentClueIndex      Int       @default(0) @map("current_clue_index")
  score                 Int       @default(0)
  attemptsOnCurrentClue Int       @default(0) @map("attempts_on_current_clue")
  completedAt           DateTime? @map("completed_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user     User?        @relation(fields: [userId], references: [id])
  scenario GameScenario @relation(fields: [scenarioId], references: [id])
  museum   Museum       @relation(fields: [museumId], references: [id])

  @@index([userId, state])
  @@map("game_sessions")
}

// ─────────────────────────────────────────────
// TABLE 8: quiz_questions
// ─────────────────────────────────────────────

model QuizQuestion {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  museumId     String        @map("museum_id") @db.Uuid
  artifactId   String?       @map("artifact_id") @db.Uuid
  questionText String        @map("question_text") @db.Text
  options      Json          @db.JsonB
  explanation  String?       @db.Text
  difficulty   Difficulty
  status       ContentStatus @default(draft)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz

  museum   Museum    @relation(fields: [museumId], references: [id])
  artifact Artifact? @relation(fields: [artifactId], references: [id])
  answers  QuizAnswer[]

  @@index([museumId])
  @@map("quiz_questions")
}

// ─────────────────────────────────────────────
// TABLE 9: quiz_sessions
// ─────────────────────────────────────────────

model QuizSession {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?    @map("user_id") @db.Uuid
  museumId          String     @map("museum_id") @db.Uuid
  difficulty        Difficulty
  totalScore        Int        @default(0) @map("total_score")
  questionsAnswered Int        @default(0) @map("questions_answered")
  correctCount      Int        @default(0) @map("correct_count")
  completedAt       DateTime?  @map("completed_at") @db.Timestamptz
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  user    User?       @relation(fields: [userId], references: [id])
  museum  Museum      @relation(fields: [museumId], references: [id])
  answers QuizAnswer[]

  @@index([museumId])
  @@map("quiz_sessions")
}

// ─────────────────────────────────────────────
// TABLE 10: quiz_answers
// ─────────────────────────────────────────────

model QuizAnswer {
  sessionId      String   @map("session_id") @db.Uuid
  questionId     String   @map("question_id") @db.Uuid
  selectedOption Int      @map("selected_option")
  isCorrect      Boolean  @map("is_correct")
  pointsEarned   Int      @map("points_earned")
  timeSpentMs    Int      @map("time_spent_ms")
  answeredAt     DateTime @default(now()) @map("answered_at") @db.Timestamptz

  session  QuizSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id])

  @@id([sessionId, questionId])
  @@index([sessionId])
  @@map("quiz_answers")
}

// ─────────────────────────────────────────────
// TABLE 11: museum_quiz_scores
// ─────────────────────────────────────────────

model MuseumQuizScore {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  museumId     String   @map("museum_id") @db.Uuid
  bestScore    Int      @map("best_score")
  quizCount    Int      @default(1) @map("quiz_count")
  lastPlayedAt DateTime @map("last_played_at") @db.Timestamptz

  user   User?  @relation(fields: [userId], references: [id])
  museum Museum @relation(fields: [museumId], references: [id])

  @@unique([userId, museumId])
  @@index([museumId])
  @@map("museum_quiz_scores")
}

// ─────────────────────────────────────────────
// TABLE 12: ai_chat_sessions
// ─────────────────────────────────────────────

model AiChatSession {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  museumId          String   @map("museum_id") @db.Uuid
  artifactContextId String?  @map("artifact_context_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User      @relation(fields: [userId], references: [id])
  museum   Museum    @relation(fields: [museumId], references: [id])
  artifact Artifact? @relation(fields: [artifactContextId], references: [id])
  messages AiMessage[]

  @@index([userId])
  @@index([museumId])
  @@map("ai_chat_sessions")
}

// ─────────────────────────────────────────────
// TABLE 13: ai_messages
// ─────────────────────────────────────────────

model AiMessage {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String        @map("session_id") @db.Uuid
  role       AiMessageRole
  content    String        @db.Text
  tokensUsed Int           @default(0) @map("tokens_used")
  flagStatus AiFlagStatus  @default(unflagged) @map("flag_status")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("ai_messages")
}

// ─────────────────────────────────────────────
// TABLE 14: rewards
// ─────────────────────────────────────────────

model Reward {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  museumId             String            @map("museum_id") @db.Uuid
  name                 String            @db.VarChar(200)
  type                 RewardType
  assetUrl             String?           @map("asset_url") @db.VarChar(500)
  description          String?           @db.Text
  triggerType          RewardTriggerType @map("trigger_type")
  triggerConfig        Json              @default("{}") @map("trigger_config") @db.JsonB
  linkedScenarioId     String?           @map("linked_scenario_id") @db.Uuid
  discountValidityDays Int?              @map("discount_validity_days")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?         @map("deleted_at") @db.Timestamptz

  museum        Museum        @relation(fields: [museumId], references: [id])
  gameScenarios GameScenario[]
  userRewards   UserReward[]

  @@index([museumId])
  @@map("rewards")
}

// ─────────────────────────────────────────────
// TABLE 15: user_rewards
// ─────────────────────────────────────────────

model UserReward {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  rewardId     String    @map("reward_id") @db.Uuid
  discountCode String?   @unique @map("discount_code") @db.VarChar(8)
  isRedeemed   Boolean   @default(false) @map("is_redeemed")
  earnedVia    Json      @map("earned_via") @db.JsonB
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id])
  reward Reward @relation(fields: [rewardId], references: [id])

  @@unique([userId, rewardId])
  @@index([userId])
  @@map("user_rewards")
}

// ─────────────────────────────────────────────
// TABLE 16: analytics_events
// TimescaleDB hypertable — partitioned by occurred_at
// Hypertable conversion done via raw SQL migration after create
// ─────────────────────────────────────────────

model AnalyticsEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  museumId    String?  @map("museum_id") @db.Uuid
  userIdHash  String?  @map("user_id_hash") @db.VarChar(128)
  eventType   String   @map("event_type") @db.VarChar(100)
  payload     Json     @default("{}") @db.JsonB
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  museum Museum? @relation(fields: [museumId], references: [id])

  @@index([occurredAt])
  @@index([museumId, occurredAt])
  @@map("analytics_events")
}

// ─────────────────────────────────────────────
// TABLE 17: audit_logs
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actorRole  String   @map("actor_role") @db.VarChar(50)
  action     String   @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(50)
  targetId   String   @map("target_id") @db.Uuid
  metadata   Json     @default("{}") @db.JsonB
  museumId   String?  @map("museum_id") @db.Uuid
  ipAddress  String   @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor  User   @relation("ActorAuditLogs", fields: [actorId], references: [id])
  museum Museum? @relation(fields: [museumId], references: [id])

  @@index([museumId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
