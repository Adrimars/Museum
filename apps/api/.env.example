# Application
NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://museumquest:museumquest@localhost:5432/museumquest

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT - RS256 asymmetric keys (generate with: openssl genrsa -out private.pem 2048)
# Store newlines as \n in single-line env vars
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Security
BCRYPT_COST_FACTOR=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000
PASSWORD_RESET_TTL_MS=900000

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Email (SendGrid)
SENDGRID_API_KEY=
FROM_EMAIL=noreply@museumquest.app

# AWS S3
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=museumquest-media

# AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# HMAC QR Signing (comma-separated JSON of {kid, secret} pairs)
QR_HMAC_SECRETS=[{"kid":"v1","secret":"change-me-to-random-32-bytes"}]

# Analytics anonymization
ANALYTICS_HMAC_SALT=change-me-to-random-32-bytes
